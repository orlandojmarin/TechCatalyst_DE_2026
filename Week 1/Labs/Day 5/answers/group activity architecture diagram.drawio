        <mxCell id="bYAil97iInwirzLSxF_o-37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;font style=&quot;font-size: 19px; line-height: 150%;&quot;&gt;&lt;b&gt;&lt;font face=&quot;Times New Roman&quot;&gt;(&lt;/font&gt;1) &lt;/b&gt;NYC TLC taxi data and the taxi zones dataset are loaded into Amazon S3 as raw data.&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px; line-height: 150%;&quot;&gt;&lt;b&gt;(2) &lt;/b&gt;Basic data quality checks are performed on the raw data.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px; line-height: 150%;&quot;&gt;&lt;b&gt;(3)&lt;/b&gt;&amp;nbsp;Data is cleaned, validated, and joined with the taxi zones dataset.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px; line-height: 150%;&quot;&gt;&lt;b&gt;(4) &lt;/b&gt;AWS Glue processes the data and registers it in the data catalog.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px; line-height: 150%;&quot;&gt;&lt;b&gt;(5) &lt;/b&gt;Amazon Athena is used to query the data.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px; line-height: 150%;&quot;&gt;&lt;b&gt;(6) &lt;/b&gt;Data is given to a specific user to put in a dashboard, use in analysis, etc.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px; line-height: 150%;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px; line-height: 150%;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px; line-height: 150%;&quot;&gt;Group Activity&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px; line-height: 150%;&quot;&gt;Recommend one run location for today: Ubuntu Terminal&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px; line-height: 150%;&quot;&gt;Recommend one future migration path: Future Orchestrator&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px; line-height: 150%;&quot;&gt;Summary output in AWS Glue&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="1520" x="30" y="700" as="geometry" />
        </mxCell>
