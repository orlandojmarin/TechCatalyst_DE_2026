<mxfile host="app.diagrams.net">
  <diagram name="NYC Taxi Demand Forecasting Pipeline" id="arch1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Zone containers -->
        <mxCell id="z1" value="INGEST" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#B22222;fillColor=#FBFAF8;strokeColor=#DDD8D2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="260" height="620" as="geometry" />
        </mxCell>
        <mxCell id="z2" value="LAKE (bronze / silver)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#B22222;fillColor=#FBFAF8;strokeColor=#DDD8D2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="320" y="60" width="300" height="620" as="geometry" />
        </mxCell>
        <mxCell id="z3" value="TRANSFORM" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#B22222;fillColor=#FBFAF8;strokeColor=#DDD8D2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="660" y="60" width="260" height="620" as="geometry" />
        </mxCell>
        <mxCell id="z4" value="WAREHOUSE (gold)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#B22222;fillColor=#FBFAF8;strokeColor=#DDD8D2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="960" y="60" width="260" height="620" as="geometry" />
        </mxCell>
        <mxCell id="z5" value="SERVE" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#B22222;fillColor=#FBFAF8;strokeColor=#DDD8D2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1260" y="60" width="280" height="620" as="geometry" />
        </mxCell>

        <!-- INGEST zone -->
        <mxCell id="src1" value="NYC TLC&#10;Yellow Taxi Trip Records&#10;(Parquet, monthly)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.general_saml_token;rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F2FF;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="src2" value="Taxi Zone Lookup&#10;(CSV, static)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.general_saml_token;rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F2FF;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lambda1" value="AWS Lambda&#10;(download + land)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9DC6C;strokeColor=#D6A800;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- LAKE zone - Bronze -->
        <mxCell id="s3bronze" value="Amazon S3&#10;Bronze&#10;(raw, as-landed)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;" vertex="1" parent="1">
          <mxGeometry x="370" y="140" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="qualcheck1" value="⚠ Data Quality Check&#10;(row counts, nulls,&#10;schema validation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;" vertex="1" parent="1">
          <mxGeometry x="370" y="280" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3silver" value="Amazon S3&#10;Silver&#10;(cleaned, validated,&#10;joined with zones)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;" vertex="1" parent="1">
          <mxGeometry x="370" y="420" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="quarantine" value="S3 Quarantine&#10;(malformed records)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="560" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- TRANSFORM zone -->
        <mxCell id="glue1" value="AWS Glue&#10;(clean, validate,&#10;join zones)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3D4F9;strokeColor=#7B1FA2;" vertex="1" parent="1">
          <mxGeometry x="700" y="160" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="glue2" value="AWS Glue&#10;(aggregate: trips by&#10;zone/hour)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3D4F9;strokeColor=#7B1FA2;" vertex="1" parent="1">
          <mxGeometry x="700" y="300" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="crawler" value="Glue Crawler&#10;(catalog each layer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3D4F9;strokeColor=#7B1FA2;" vertex="1" parent="1">
          <mxGeometry x="700" y="440" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pii" value="🔒 PII Check&#10;(zone-level only,&#10;no exact addresses)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;" vertex="1" parent="1">
          <mxGeometry x="700" y="560" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- WAREHOUSE zone -->
        <mxCell id="athena" value="Amazon Athena&#10;(ad-hoc queries&#10;on lake data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="160" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="redshift" value="Amazon Redshift&#10;(gold: aggregated&#10;demand metrics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="310" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dynamo" value="Amazon DynamoDB&#10;(forecast results&#10;for serving)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="460" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- SERVE zone -->
        <mxCell id="quicksight" value="Amazon QuickSight&#10;(demand heatmap&#10;dashboard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;" vertex="1" parent="1">
          <mxGeometry x="1300" y="160" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="apigateway" value="API Gateway +&#10;Lambda&#10;(forecast API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;" vertex="1" parent="1">
          <mxGeometry x="1300" y="310" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="users" value="Fleet Ops Managers&#10;/ Analysts" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;" vertex="1" parent="1">
          <mxGeometry x="1300" y="460" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ORCHESTRATION (bottom bar) -->
        <mxCell id="orch" value="ORCHESTRATION: AWS Step Functions + EventBridge (monthly schedule, retries, alerts via SNS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="730" width="1520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="monitor" value="OBSERVABILITY: Amazon CloudWatch (job metrics, row counts, failure alerts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="800" width="1520" height="50" as="geometry" />
        </mxCell>

        <!-- Arrows with labels -->
        <!-- Ingest to Bronze -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="src1" target="s3bronze" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1label" value="Parquet files&#10;monthly" style="edgeLabel;html=1;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="a1">
          <mxGeometry x="-0.2" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="src2" target="s3bronze" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2label" value="CSV&#10;one-time load" style="edgeLabel;html=1;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="a2">
          <mxGeometry x="-0.2" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="a2b" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="lambda1" target="s3bronze" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2blabel" value="downloads&#10;and lands files" style="edgeLabel;html=1;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="a2b">
          <mxGeometry x="-0.2" relative="1" as="geometry" />
        </mxCell>

        <!-- Bronze to Quality Check -->
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s3bronze" target="qualcheck1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Quality Check to Silver -->
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="qualcheck1" target="s3silver" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4label" value="passes validation" style="edgeLabel;html=1;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="a4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Quality Check to Quarantine -->
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="qualcheck1" target="quarantine" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5label" value="fails validation" style="edgeLabel;html=1;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="a5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bronze to Glue (transform) -->
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s3bronze" target="glue1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6label" value="raw Parquet&#10;monthly" style="edgeLabel;html=1;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="a6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Glue1 back to Silver -->
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="glue1" target="s3silver" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7label" value="cleaned Parquet&#10;(joined with zones)" style="edgeLabel;html=1;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="a7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Silver to Glue2 (aggregate) -->
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s3silver" target="glue2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a8label" value="silver Parquet&#10;monthly" style="edgeLabel;html=1;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="a8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Glue2 to Redshift -->
        <mxCell id="a9" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="glue2" target="redshift" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a9label" value="aggregated metrics&#10;(trips by zone/hour)&#10;monthly" style="edgeLabel;html=1;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="a9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Silver to Athena -->
        <mxCell id="a10" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s3silver" target="athena" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a10label" value="query in place&#10;ad-hoc" style="edgeLabel;html=1;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="a10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Redshift to DynamoDB -->
        <mxCell id="a11" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="redshift" target="dynamo" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a11label" value="forecast results&#10;daily/weekly" style="edgeLabel;html=1;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="a11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Redshift to QuickSight -->
        <mxCell id="a12" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="redshift" target="quicksight" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a12label" value="demand metrics&#10;dashboard refresh" style="edgeLabel;html=1;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="a12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DynamoDB to API Gateway -->
        <mxCell id="a13" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="dynamo" target="apigateway" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a13label" value="forecast lookup&#10;on demand" style="edgeLabel;html=1;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="a13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- QuickSight to Users -->
        <mxCell id="a14" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="quicksight" target="users" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API Gateway to Users -->
        <mxCell id="a15" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="apigateway" target="users" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pipeline pattern label -->
        <mxCell id="patternlabel" value="Pipeline Pattern: ELT&#10;(land raw data first, then transform in place)" style="text;html=1;align=left;verticalAlign=top;fontStyle=1;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="500" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
